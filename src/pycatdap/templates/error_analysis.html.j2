<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>pycatdap error_analysis — task: {{ task }}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
  h1 { font-size: 1.6rem; border-bottom: 1px solid #d0d7de; padding-bottom: .4rem; }
  h2 { font-size: 1.25rem; margin-top: 2rem; border-bottom: 1px solid #eaecef; padding-bottom: .3rem; }
  h3 { font-size: 1.05rem; margin-top: 1.5rem; }
  .meta { color: #57606a; font-size: .9rem; }
  table { border-collapse: collapse; width: 100%; margin: .5rem 0 1rem; font-size: .92rem; }
  th, td { border: 1px solid #d0d7de; padding: .35rem .6rem; text-align: left; }
  th { background: #f6f8fa; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .delta-neg { color: #1a7f37; font-weight: 600; }
  .delta-pos { color: #cf222e; font-weight: 600; }
  .resid-strong { background: #ffebe9; }
  .summary-card { border: 1px solid #d0d7de; border-radius: 6px; padding: .8rem 1rem; background: #fff; max-width: 720px; }
  .summary-card dl { margin: .4rem 0 0; display: grid; grid-template-columns: max-content 1fr; gap: .15rem .6rem; font-size: .9rem; }
  .summary-card dt { color: #57606a; }
  .summary-card dd { margin: 0; font-variant-numeric: tabular-nums; }
  .top-summary { margin-top: 1rem; padding-top: .5rem; border-top: 1px dashed #d0d7de; }
</style>
</head>
<body>
<h1>pycatdap error_analysis <span class="meta">(task: <code>{{ task }}</code>)</span></h1>
<p class="meta">{{ n_rows }} rows · label_kind = <code>{{ label_kind }}</code> · generated by pycatdap {{ pycatdap_version }}</p>

<h2>Overview</h2>
<div class="summary-card">
  <dl>
    <dt>task</dt><dd>{{ task }}</dd>
    <dt>label_kind</dt><dd><code>{{ label_kind }}</code></dd>
    <dt>n_rows</dt><dd>{{ n_rows }}</dd>
    {% if n_correct is not none %}
      <dt>n_correct</dt><dd>{{ n_correct }}</dd>
      <dt>n_incorrect</dt><dd>{{ n_incorrect }}</dd>
      <dt>accuracy</dt><dd>{{ (n_correct / n_rows) | round(4) }}</dd>
    {% endif %}
    {% if mae is not none %}
      <dt>MAE</dt><dd>{{ mae | round(4) }}</dd>
      <dt>RMSE</dt><dd>{{ rmse | round(4) }}</dd>
    {% endif %}
  </dl>
</div>

{% if confusion %}
<h2>Confusion</h2>
<table>
  <thead><tr><th>category</th><th>count</th></tr></thead>
  <tbody>
    {% for row in confusion %}
    <tr><td><code>{{ row.category }}</code></td><td class="num">{{ row.count }}</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<h2>Feature ranking ({{ ranking | length }} variables)</h2>
<p class="meta">Sorted ascending by ΔAIC against the synthetic <code>{{ response_name }}</code> column — negative (green) = informative.</p>
<table>
  <thead><tr><th>variable</th><th>ΔAIC</th><th>kind</th><th>n_obs</th></tr></thead>
  <tbody>
    {% for row in ranking %}
    <tr>
      <td><code>{{ row.variable }}</code></td>
      <td class="num {% if row.delta_aic < 0 %}delta-neg{% elif row.delta_aic > 0 %}delta-pos{% endif %}">{{ row.delta_aic | round(3) }}</td>
      <td>{{ row.kind }}</td>
      <td class="num">{{ row.n_obs }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if top_slices %}
<h2>Top {{ top_slices | length }} error slices</h2>
<p class="meta">Single-variable cells where one error category concentrates with |pearson_residual| ≥ 2.0.</p>
<table>
  <thead><tr><th>variable</th><th>category</th><th>error</th><th>n_slice</th><th>n_error</th><th>error_rate</th><th>residual</th><th>ΔAIC(var)</th></tr></thead>
  <tbody>
    {% for s in top_slices %}
    <tr class="resid-strong">
      <td><code>{{ s.variable }}</code></td>
      <td><code>{{ s.category }}</code></td>
      <td><code>{{ s.error_category }}</code></td>
      <td class="num">{{ s.n_in_slice }}</td>
      <td class="num">{{ s.n_error_in_slice }}</td>
      <td class="num">{{ s.error_rate | round(3) }}</td>
      <td class="num">{{ s.pearson_residual | round(2) }}</td>
      <td class="num">{{ s.delta_aic | round(3) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if top_summaries %}
<h2>Top {{ top_summaries | length }} summaries</h2>
<p class="meta">Cross-tab + Pearson residual tables for the most informative explanatory variables (Plotly embedded inline, offline-viewable).</p>
{% for summary in top_summaries %}
<div class="top-summary">
  <h3><code>{{ summary.name }}</code> <span class="meta">ΔAIC = {{ summary.delta_aic }}</span></h3>
  {{ summary.html | safe }}
</div>
{% endfor %}
{% endif %}

</body>
</html>
