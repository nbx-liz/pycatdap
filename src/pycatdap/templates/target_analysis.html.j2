<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>pycatdap target_analysis — response: {{ response }}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
  h1 { font-size: 1.6rem; border-bottom: 1px solid #d0d7de; padding-bottom: .4rem; }
  h2 { font-size: 1.25rem; margin-top: 2rem; border-bottom: 1px solid #eaecef; padding-bottom: .3rem; }
  h3 { font-size: 1.05rem; margin-top: 1.5rem; }
  .meta { color: #57606a; font-size: .9rem; }
  table { border-collapse: collapse; width: 100%; margin: .5rem 0 1rem; font-size: .92rem; }
  th, td { border: 1px solid #d0d7de; padding: .35rem .6rem; text-align: left; }
  th { background: #f6f8fa; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .delta-neg { color: #1a7f37; font-weight: 600; }
  .delta-pos { color: #cf222e; font-weight: 600; }
  .response-card { border: 1px solid #d0d7de; border-radius: 6px; padding: .8rem 1rem; background: #fff; max-width: 480px; }
  .response-card dl { margin: .4rem 0 0; display: grid; grid-template-columns: max-content 1fr; gap: .15rem .6rem; font-size: .9rem; }
  .response-card dt { color: #57606a; }
  .response-card dd { margin: 0; font-variant-numeric: tabular-nums; }
  .top-summary { margin-top: 1rem; padding-top: .5rem; border-top: 1px dashed #d0d7de; }
</style>
</head>
<body>
<h1>pycatdap target_analysis <span class="meta">(response: <code>{{ response }}</code>)</span></h1>
<p class="meta">{{ n_rows }} rows × {{ n_cols }} columns · generated by pycatdap {{ pycatdap_version }}</p>

<h2>Response variable</h2>
<div class="response-card">
  <h3><code>{{ response_card.name }}</code></h3>
  <div class="meta">{{ response_card.kind }}</div>
  <dl>
    <dt>n_obs</dt><dd>{{ response_card.n_obs }}</dd>
    <dt>missing</dt><dd>{{ response_card.n_missing }}</dd>
    <dt>unique</dt><dd>{{ response_card.n_unique }}</dd>
    {% if response_card.top_value is not none %}
      <dt>top</dt><dd><code>{{ response_card.top_value }}</code> ×{{ response_card.top_freq }}</dd>
    {% endif %}
    {% if response_card.stats %}
      {% for key, value in response_card.stats.items() %}
        <dt>{{ key }}</dt><dd>{{ value | round(3) }}</dd>
      {% endfor %}
    {% endif %}
  </dl>
</div>

<h2>Ranking ({{ ranking | length }} variables)</h2>
<p class="meta">Sorted ascending by ΔAIC — negative (green) = informative, positive (red) = non-informative.</p>
<table>
  <thead><tr><th>variable</th><th>ΔAIC</th><th>kind</th><th>n_obs</th></tr></thead>
  <tbody>
    {% for row in ranking %}
    <tr>
      <td><code>{{ row.variable }}</code></td>
      <td class="num {% if row.delta_aic < 0 %}delta-neg{% elif row.delta_aic > 0 %}delta-pos{% endif %}">{{ row.delta_aic | round(3) }}</td>
      <td>{{ row.kind }}</td>
      <td class="num">{{ row.n_obs }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if top_summaries %}
<h2>Top {{ top_summaries | length }} summaries</h2>
<p class="meta">Full cross-tab tables for the most informative explanatory variables. Plotly figures are embedded inline (offline-viewable).</p>
{% for summary in top_summaries %}
<div class="top-summary">
  <h3><code>{{ summary.name }}</code> <span class="meta">ΔAIC = {{ summary.delta_aic }}</span></h3>
  {{ summary.html | safe }}
</div>
{% endfor %}
{% endif %}

</body>
</html>
