<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>pycatdap profile{% if response %} — response: {{ response }}{% endif %}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
  h1 { font-size: 1.6rem; border-bottom: 1px solid #d0d7de; padding-bottom: .4rem; }
  h2 { font-size: 1.25rem; margin-top: 2rem; border-bottom: 1px solid #eaecef; padding-bottom: .3rem; }
  .meta { color: #57606a; font-size: .9rem; }
  table { border-collapse: collapse; width: 100%; margin: .5rem 0 1rem; font-size: .92rem; }
  th, td { border: 1px solid #d0d7de; padding: .35rem .6rem; text-align: left; }
  th { background: #f6f8fa; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: .75rem; margin: .5rem 0; }
  .card { border: 1px solid #d0d7de; border-radius: 6px; padding: .6rem .8rem; background: #fff; }
  .card h3 { margin: 0 0 .25rem; font-size: 1rem; }
  .card .kind { font-size: .8rem; color: #57606a; }
  .card dl { margin: .4rem 0 0; display: grid; grid-template-columns: max-content 1fr; gap: .15rem .6rem; font-size: .88rem; }
  .card dt { color: #57606a; }
  .card dd { margin: 0; font-variant-numeric: tabular-nums; }
  .severity-warning { color: #cf222e; font-weight: 600; }
  .severity-info { color: #0969da; font-weight: 600; }
  .delta-pos { color: #cf222e; }
  .delta-neg { color: #1a7f37; }
  .delta-null { color: #57606a; }
</style>
</head>
<body>
<h1>pycatdap profile{% if response %} <span class="meta">(response: <code>{{ response }}</code>)</span>{% endif %}</h1>
<p class="meta">{{ n_rows }} rows × {{ n_cols }} columns · generated by pycatdap {{ pycatdap_version }}</p>

<h2>Overview</h2>
<table>
  <thead><tr><th>metric</th><th>value</th></tr></thead>
  <tbody>
    <tr><td>rows</td><td class="num">{{ overview.n_rows }}</td></tr>
    <tr><td>columns</td><td class="num">{{ overview.n_cols }}</td></tr>
    <tr><td>missing cells</td><td class="num">{{ overview.n_missing }} ({{ (overview.missing_rate * 100) | round(2) }}%)</td></tr>
    <tr><td>duplicate rows</td><td class="num">{{ overview.n_duplicates }}</td></tr>
    <tr><td>memory</td><td class="num">{{ (overview.memory_bytes / 1024) | round(1) }} KiB</td></tr>
    <tr><td>dtypes</td><td>{% for dtype, count in overview.dtype_counts.items() %}{{ dtype }} ×{{ count }}{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
  </tbody>
</table>

{% if quality_warnings %}
<h2>Quality warnings</h2>
<table>
  <thead><tr><th>severity</th><th>kind</th><th>column</th><th>message</th></tr></thead>
  <tbody>
    {% for w in quality_warnings %}
    <tr>
      <td class="severity-{{ w.severity }}">{{ w.severity }}</td>
      <td><code>{{ w.kind }}</code></td>
      <td><code>{{ w.column }}</code></td>
      <td>{{ w.message }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<h2>Variables</h2>
<div class="cards">
  {% for card in variables %}
  <div class="card">
    <h3><code>{{ card.name }}</code></h3>
    <div class="kind">{{ card.kind }}</div>
    <dl>
      <dt>n_obs</dt><dd>{{ card.n_obs }}</dd>
      <dt>missing</dt><dd>{{ card.n_missing }}</dd>
      <dt>unique</dt><dd>{{ card.n_unique }}</dd>
      {% if card.top_value is not none %}<dt>top</dt><dd><code>{{ card.top_value }}</code> ×{{ card.top_freq }}</dd>{% endif %}
      {% if card.stats %}
        {% for key, value in card.stats.items() %}
        <dt>{{ key }}</dt><dd>{{ value | round(3) }}</dd>
        {% endfor %}
      {% endif %}
      {% if card.delta_aic_vs_response is not none %}
        <dt>ΔAIC vs <code>{{ response }}</code></dt>
        <dd class="{% if card.delta_aic_vs_response < 0 %}delta-neg{% elif card.delta_aic_vs_response > 0 %}delta-pos{% else %}delta-null{% endif %}">{{ card.delta_aic_vs_response | round(3) }}</dd>
      {% endif %}
    </dl>
  </div>
  {% endfor %}
</div>

<h2>Pairwise associations (ΔAIC)</h2>
<p class="meta">Asymmetric matrix: cell (i, j) = ΔAIC when treating row i as response and column j as explanatory. Negative (green) = informative, positive (red) = non-informative, diagonal undefined.</p>
{{ association_heatmap_html | safe }}

{% if top_subsets_html %}
<h2>Top subsets (CATDAP-02)</h2>
<p class="meta">Single-variable ΔAIC for each candidate explanatory; best (most negative) at the top.</p>
{{ top_subsets_html | safe }}
{% endif %}

</body>
</html>
