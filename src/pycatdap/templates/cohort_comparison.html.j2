<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>pycatdap compare_cohorts</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
  h1 { font-size: 1.6rem; border-bottom: 1px solid #d0d7de; padding-bottom: .4rem; }
  h2 { font-size: 1.25rem; margin-top: 2rem; border-bottom: 1px solid #eaecef; padding-bottom: .3rem; }
  h3 { font-size: 1.05rem; margin-top: 1.5rem; }
  .meta { color: #57606a; font-size: .9rem; }
  table { border-collapse: collapse; width: 100%; margin: .5rem 0 1rem; font-size: .92rem; }
  th, td { border: 1px solid #d0d7de; padding: .35rem .6rem; text-align: left; }
  th { background: #f6f8fa; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .delta-neg { color: #1a7f37; font-weight: 600; }
  .delta-pos { color: #cf222e; font-weight: 600; }
  .bar { display: inline-block; height: .7rem; background: #54aeff; vertical-align: middle; }
  .bar-b { background: #ffab70; }
</style>
</head>
<body>
<h1>pycatdap compare_cohorts</h1>
<p class="meta">cohort A = {{ n_a }} rows · cohort B = {{ n_b }} rows · generated by pycatdap {{ pycatdap_version }}</p>

<h2>Feature discriminativeness</h2>
<p class="meta">ΔAIC of cohort membership per feature — more negative = the feature distinguishes the cohorts more strongly.</p>
<table>
  <thead><tr><th>variable</th><th>ΔAIC</th><th>max |Δprop|</th></tr></thead>
  <tbody>
    {% for col in columns %}
    <tr>
      <td><code>{{ col.variable }}</code></td>
      <td class="num {% if col.delta_aic|float < 0 %}delta-neg{% else %}delta-pos{% endif %}">{{ col.delta_aic }}</td>
      <td class="num">{{ col.max_abs_diff }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if has_response %}
<h2>Response-relationship shift</h2>
<p class="meta">Per-feature ΔAIC against the response in each cohort, and the shift (B − A).</p>
<table>
  <thead><tr><th>variable</th><th>ΔAIC (A)</th><th>ΔAIC (B)</th><th>shift</th></tr></thead>
  <tbody>
    {% for row in response_delta %}
    <tr>
      <td><code>{{ row.variable }}</code></td>
      <td class="num">{{ row.delta_aic_a | round(4) }}</td>
      <td class="num">{{ row.delta_aic_b | round(4) }}</td>
      <td class="num">{{ row.shift | round(4) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<h2>Per-feature distributions</h2>
{% for col in columns %}
<h3><code>{{ col.variable }}</code></h3>
<table>
  <thead><tr><th>value</th><th>prop A</th><th>prop B</th><th>diff</th></tr></thead>
  <tbody>
    {% for row in col.distribution %}
    <tr>
      <td><code>{{ row.value }}</code></td>
      <td class="num">{{ row.prop_a | round(4) }}</td>
      <td class="num">{{ row.prop_b | round(4) }}</td>
      <td class="num {% if row.diff < 0 %}delta-pos{% else %}delta-neg{% endif %}">{{ row.diff | round(4) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endfor %}

</body>
</html>
