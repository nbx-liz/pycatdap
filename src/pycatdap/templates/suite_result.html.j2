<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>pycatdap {{ suite_name }}{% if response %} — response: {{ response }}{% endif %}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
  h1 { font-size: 1.6rem; border-bottom: 1px solid #d0d7de; padding-bottom: .4rem; }
  h2 { font-size: 1.25rem; margin-top: 2rem; border-bottom: 1px solid #eaecef; padding-bottom: .3rem; }
  .meta { color: #57606a; font-size: .9rem; }
  .badge { display: inline-block; padding: .15rem .55rem; border-radius: 12px; font-weight: 600; font-size: .9rem; }
  .badge-pass { background: #dafbe1; color: #1a7f37; }
  .badge-fail { background: #ffebe9; color: #cf222e; }
  table { border-collapse: collapse; width: 100%; margin: .5rem 0 1rem; font-size: .92rem; }
  th, td { border: 1px solid #d0d7de; padding: .35rem .6rem; text-align: left; vertical-align: top; }
  th { background: #f6f8fa; }
  .check-pass { color: #1a7f37; font-weight: 600; }
  .check-fail { color: #cf222e; font-weight: 600; }
  .severity-warning { color: #cf222e; }
  .severity-info { color: #0969da; }
  .summary-line { padding: .8rem 1rem; border: 1px solid #d0d7de; border-radius: 6px; background: #f6f8fa; font-family: ui-monospace, SFMono-Regular, monospace; font-size: .92rem; }
</style>
</head>
<body>
<h1>pycatdap {{ suite_name }}{% if response %} <span class="meta">(response: <code>{{ response }}</code>)</span>{% endif %}</h1>
<p class="meta">
  {{ n_rows }} rows × {{ n_cols }} columns · generated by pycatdap {{ pycatdap_version }} ·
  status:
  {% if passed %}<span class="badge badge-pass">passed</span>{% else %}<span class="badge badge-fail">failed</span>{% endif %}
</p>

<h2>Summary</h2>
<div class="summary-line">{{ summary_line }}</div>

<h2>Checks ({{ checks | length }})</h2>
<table>
  <thead>
    <tr>
      <th>check</th>
      <th>passed</th>
      <th>severity</th>
      <th>metric</th>
      <th>affected columns</th>
      <th>message</th>
    </tr>
  </thead>
  <tbody>
    {% for c in checks %}
    <tr>
      <td><code>{{ c.name }}</code></td>
      <td class="{% if c.passed %}check-pass{% else %}check-fail{% endif %}">{{ c.passed }}</td>
      <td class="severity-{{ c.severity }}">{{ c.severity }}</td>
      <td>{% if c.metric is not none %}{{ c.metric | round(4) }}{% endif %}</td>
      <td>{% for col in c.affected_columns %}<code>{{ col }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</td>
      <td>{{ c.message }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

</body>
</html>
