<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>pycatdap quality report</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
  h1 { font-size: 1.6rem; border-bottom: 1px solid #d0d7de; padding-bottom: .4rem; }
  h2 { font-size: 1.25rem; margin-top: 2rem; border-bottom: 1px solid #eaecef; padding-bottom: .3rem; }
  .meta { color: #57606a; font-size: .9rem; }
  .badge { display: inline-block; padding: .15rem .55rem; border-radius: 12px; font-weight: 600; font-size: .9rem; }
  .badge-pass { background: #dafbe1; color: #1a7f37; }
  .badge-fail { background: #ffebe9; color: #cf222e; }
  table { border-collapse: collapse; width: 100%; margin: .5rem 0 1rem; font-size: .92rem; }
  th, td { border: 1px solid #d0d7de; padding: .35rem .6rem; text-align: left; }
  th { background: #f6f8fa; }
  .severity-warning { color: #cf222e; font-weight: 600; }
  .severity-info { color: #0969da; font-weight: 600; }
  .group-counts dt { display: inline; font-weight: 600; }
  .group-counts dd { display: inline; margin: 0 1rem 0 .25rem; }
  .empty { padding: 1rem; background: #f6f8fa; border: 1px solid #d0d7de; border-radius: 6px; color: #57606a; text-align: center; }
</style>
</head>
<body>
<h1>pycatdap quality report</h1>
<p class="meta">
  {{ n_rows }} rows × {{ n_cols }} columns · generated by pycatdap {{ pycatdap_version }} ·
  status:
  {% if passed %}<span class="badge badge-pass">passed</span>{% else %}<span class="badge badge-fail">failed</span>{% endif %}
</p>

{% if warnings %}
<h2>Warnings ({{ warnings | length }})</h2>
<dl class="group-counts">
  {% for kind, count in counts_by_kind.items() %}
  <dt>{{ kind }}</dt><dd>{{ count }}</dd>
  {% endfor %}
</dl>
<table>
  <thead><tr><th>severity</th><th>kind</th><th>column</th><th>message</th><th>metric</th></tr></thead>
  <tbody>
    {% for w in warnings %}
    <tr>
      <td class="severity-{{ w.severity }}">{{ w.severity }}</td>
      <td><code>{{ w.kind }}</code></td>
      <td><code>{{ w.column }}</code></td>
      <td>{{ w.message }}</td>
      <td>{{ w.metric | round(4) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<div class="empty">No quality warnings — frame passed all default checks.</div>
{% endif %}

</body>
</html>
